graph MER {
  graph [rankdir=TB, fontname="Arial", nodesep=0.5, ranksep=0.7, pad=0.3, bgcolor="white"];
  node  [fontname="Arial", fontsize=12];
  edge  [fontname="Arial", fontsize=11, color="#37474F"];

  node [shape=box, style="filled", fillcolor="#E0F2F1", color="#00695C", penwidth=1.6, margin="0.25,0.15"];
  CIDADAO; OCORRENCIA; CATEGORIA; ORGAO; APOIO; HISTORICO [label="HISTÓRICO\nDE STATUS"];

  node [shape=diamond, style="filled", fillcolor="#FFF8E1", color="#F9A825", penwidth=1.4, fontsize=11, margin="0.05"];
  registra [label="registra"];
  classifica [label="classifica"];
  atende [label="é atendida\npor"];
  da [label="dá"];
  recebe [label="recebe"];
  possui [label="possui"];

  CIDADAO -- registra [label="1", fontcolor="#C62828"];
  registra -- OCORRENCIA [label="N", fontcolor="#C62828"];
  CATEGORIA -- classifica [label="1", fontcolor="#C62828"];
  classifica -- OCORRENCIA [label="N", fontcolor="#C62828"];
  ORGAO -- atende [label="1", fontcolor="#C62828"];
  atende -- CATEGORIA [label="N", fontcolor="#C62828"];
  CIDADAO -- da [label="1", fontcolor="#C62828"];
  da -- APOIO [label="N", fontcolor="#C62828"];
  OCORRENCIA -- recebe [label="1", fontcolor="#C62828"];
  recebe -- APOIO [label="N", fontcolor="#C62828"];
  OCORRENCIA -- possui [label="1", fontcolor="#C62828"];
  possui -- HISTORICO [label="N", fontcolor="#C62828"];
}
